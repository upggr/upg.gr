---
import '../styles/global.css';
import HeadScripts from '../components/HeadScripts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, langFromUrl, alternatePath, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Optional OG image path relative to the site root. */
  image?: string;
}

const { title, description, image = '/og.png' } = Astro.props;

const lang = langFromUrl(Astro.url) as Lang;
const t = getDict(lang);

const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', site.url).href;
const elHref = new URL(alternatePath(Astro.url, 'el'), site.url).href;
const enHref = new URL(alternatePath(Astro.url, 'en'), site.url).href;
const ogImage = new URL(image, site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email,
  telephone: site.phones.map((p) => p.display),
  image: ogImage,
  description,
  areaServed: 'GR',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Zakynthos',
    addressRegion: 'Ionian Islands',
    addressCountry: 'GR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.offices[0].lat,
    longitude: site.offices[0].lng,
  },
  sameAs: [...site.social.map((s) => s.href), site.sister.url],
};
---

<!doctype html>
<html lang={lang} dir={t.meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="el" href={elHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={elHref} />

    <meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lang === 'el' && (
      <link rel="preload" href="/fonts/inter-greek.woff2" as="font" type="font/woff2" crossorigin />
    )}

    <HeadScripts />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Only needed where scroll-driven CSS animations are unavailable.
      const supportsViewTimeline = CSS.supports('animation-timeline', 'view()');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!supportsViewTimeline && !reduced && 'IntersectionObserver' in window) {
        const targets = document.querySelectorAll<HTMLElement>('.reveal');
        // Opt in to the hidden state only now that we know we can reveal them.
        document.documentElement.classList.add('js-reveal');

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));

        // Safety net: if anything is still hidden shortly after load, show it.
        window.addEventListener('load', () => {
          setTimeout(() => {
            targets.forEach((el) => {
              const r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('is-visible');
            });
          }, 200);
        });
      }
    </script>
  </body>
</html>

<style>
  body { display: flex; flex-direction: column; }
  main { flex: 1 0 auto; }
</style>
