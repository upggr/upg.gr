---
interface Props {
  title: string;
  url: string | null;
  tags: string[];
  thumb: string | null;
  visitLabel: string;
  eager?: boolean;
}
const { title, url, tags, thumb, visitLabel, eager = false } = Astro.props as Props;

const host = url ? url.replace(/^https?:\/\//, '').replace(/\/+$/, '') : null;
const Tag = url ? 'a' : 'div';
---

<Tag
  class:list={['project-card', { 'project-card--link': !!url }]}
  {...url ? { href: url, target: '_blank', rel: 'noopener' } : {}}
>
  <div class="project-card__media">
    {thumb ? (
      <img
        src={thumb}
        alt=""
        width="760"
        height="510"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <span class="project-card__placeholder" aria-hidden="true">
        {title.slice(0, 2).toUpperCase()}
      </span>
    )}
  </div>

  <div class="project-card__body">
    <h3 class="project-card__title">{title}</h3>
    {host && <p class="project-card__host">{host}</p>}
    {tags.length > 0 && (
      <ul class="project-card__tags">
        {tags.slice(0, 3).map((tag) => <li class="pill">{tag}</li>)}
      </ul>
    )}
    {url && <span class="project-card__cta">{visitLabel} →</span>}
  </div>
</Tag>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-width: 0;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .project-card--link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: hsl(var(--primary) / 0.45);
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: hsl(var(--surface-2));
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .project-card__placeholder {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    color: hsl(var(--primary) / 0.55);
    letter-spacing: 0.05em;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    flex: 1;
    min-width: 0;
  }
  .project-card__title {
    font-size: 0.975rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .project-card__host {
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    overflow-wrap: anywhere;
  }
  .project-card__tags {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .project-card__tags .pill { font-size: 0.68rem; padding: 0.15rem 0.5rem; }
  .project-card__cta {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: hsl(var(--primary-text));
  }
</style>
