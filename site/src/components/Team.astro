---
import { getDict, langFromUrl, type Lang } from '../i18n';

const lang = langFromUrl(Astro.url) as Lang;
const t = getDict(lang);

/** Initials stand in for photos — consistent in both languages and both themes. */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
---

<section class="section" id="team">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.team.eyebrow}</p>
      <h2 class="section-title">{t.team.title}</h2>
    </header>

    <div class="grid grid--4">
      {t.team.members.map((m) => (
        <article class="card card--hover reveal team-card">
          <span class="team-card__avatar" aria-hidden="true">{initials(m.name)}</span>
          <h3 class="card__title team-card__name">{m.name}</h3>
          <p class="team-card__role">{m.role}</p>
          <p class="card__text mt-2">{m.bio}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-card__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, hsl(var(--primary) / 0.9), hsl(var(--primary) / 0.55));
    color: hsl(var(--primary-foreground));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }
  .team-card__name { font-size: 1.05rem; }
  .team-card__role {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--primary-text));
    margin-top: 0.2rem;
  }
  .team-card .card__text { font-size: 0.9rem; }
</style>
