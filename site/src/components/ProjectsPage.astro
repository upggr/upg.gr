---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import { getDict, langFromUrl, type Lang } from '../i18n';
import projects from '../data/projects.json';
import { serviceReach } from '../data/service-reach';

const lang = langFromUrl(Astro.url) as Lang;
const t = getDict(lang);

type Category = keyof typeof t.projects.categories;
const label = (id: string) => t.projects.categories[id as Category] ?? id;

/*
 * One tab per service, so every engagement is reachable — not just the
 * website work. Websites lead because they are the only entries with a
 * screenshot; the rest render as name tiles.
 */
const TAB_ORDER = [
  'Web Design',
  'Hosting Only',
  'Cybersecurity',
  'Microsoft 365',
  'Managed IT',
  'Cloud Infrastructure',
  'Web Services',
  'VoIP',
  'Web Hosting',
  'Networking',
];

const counts = new Map<string, number>();
for (const project of projects) {
  for (const tab of project.tabs) counts.set(tab, (counts.get(tab) ?? 0) + 1);
}

const tabs = TAB_ORDER.filter((id) => counts.has(id)).map((id) => ({
  id,
  count: counts.get(id) ?? 0,
  label: label(id),
}));

/*
 * Counts of live client engagements, taken from billing rather than from the
 * portfolio: the portfolio only records showcase work, so it badly understated
 * how many businesses are actually on each service.
 */
const serviceStats = serviceReach.map((stat) => ({
  ...stat,
  label: t.projects.reach[stat.id],
}));

/** Cards past this count start hidden within each tab, and reveal on demand. */
const INITIAL = 24;
---

<Base title={t.meta.projects.title} description={t.meta.projects.description}>
  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">{t.projects.eyebrow}</p>
        <h1 class="section-title">{t.projects.title}</h1>
        <p class="section-lead">{t.projects.lead}</p>
      </header>

      <div class="project-tabs" data-project-tabs>
        <div class="tabs__list" role="tablist" aria-label={t.projects.eyebrow}>
          {tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`projects-tab-${i}`}
              aria-controls={`projects-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tabs__btn"
            >
              {tab.label}
              <span class="tabs__count">{tab.count}</span>
            </button>
          ))}
        </div>

        {tabs.map((tab, i) => {
          const items = projects.filter((project) => project.tabs.includes(tab.id));
          return (
            <div
              role="tabpanel"
              id={`projects-panel-${i}`}
              aria-labelledby={`projects-tab-${i}`}
              class="project-tabs__panel"
              data-first={i === 0 ? 'true' : 'false'}
              tabindex="0"
            >
              {tab.id === 'Hosting Only' && (
                <p class="section-lead panel-note">{t.projects.hostingOnlyLead}</p>
              )}
              <div class="projects-grid">
                {items.map((project, j) => (
                  <div class="projects-grid__item" hidden={j >= INITIAL}>
                    <ProjectCard
                      title={project.title}
                      url={project.url}
                      tags={project.tags.slice(0, 2)}
                      thumb={project.thumb}
                      visitLabel={t.projects.visit}
                      eager={i === 0 && j < 6}
                    />
                  </div>
                ))}
              </div>
              {items.length > INITIAL && (
                <p class="mt-8 text-center">
                  <button type="button" class="btn btn--outline" data-show-more>
                    {t.projects.showMore}
                  </button>
                </p>
              )}
            </div>
          );
        })}
      </div>

      <section class="services-summary" aria-labelledby="services-summary-title">
        <h2 class="services-summary__title" id="services-summary-title">
          {t.projects.beyondWeb}
        </h2>
        <p class="section-lead">{t.projects.beyondWebLead}</p>
        <dl class="services-summary__grid">
          {serviceStats.map((stat) => (
            <div class="services-summary__stat">
              <dt class="services-summary__value">{stat.count}</dt>
              <dd class="services-summary__label">{stat.label}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </section>
</Base>

<style>
  .projects-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .projects-grid__item { min-width: 0; }
  .projects-grid__item[hidden] { display: none; }

  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .tabs__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--surface));
    color: hsl(var(--muted-foreground));
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .tabs__btn:hover { color: hsl(var(--foreground)); border-color: hsl(var(--primary) / 0.5); }
  .tabs__btn[aria-selected='true'] {
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }
  .tabs__count {
    font-size: 0.72rem;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }
  .tabs__btn[aria-selected='true'] .tabs__count { color: inherit; }

  /* Without JS every panel stays visible, so nothing is unreachable. */
  :global(html.js) .project-tabs__panel[hidden] { display: none; }
  .project-tabs__panel + .project-tabs__panel { margin-top: 2.5rem; }
  :global(html.js) .project-tabs__panel + .project-tabs__panel { margin-top: 0; }

  .panel-note { margin-bottom: 1.5rem; }

  .services-summary {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid hsl(var(--border));
  }
  .services-summary__title { font-size: clamp(1.3rem, 3vw, 1.75rem); }
  .services-summary .section-lead { margin-bottom: 2rem; }

  /* Fixed column counts rather than auto-fit: six tiles divide evenly by both
     2 and 3, so the last row is never left half empty. */
  .services-summary__grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    background: hsl(var(--border));
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 48rem) {
    .services-summary__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .services-summary__stat {
    background: hsl(var(--card));
    padding: clamp(1rem, 3vw, 1.5rem);
    text-align: center;
    min-width: 0;
  }
  /* The tile count is kept to a multiple of the column counts above (see
     serviceStats), so the final row always fills flush. */
  .services-summary__value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 700;
    line-height: 1.1;
    color: hsl(var(--primary-text));
    font-variant-numeric: tabular-nums;
  }
  .services-summary__label {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
  }
</style>

<script>
  // "Show more" reveals the rest of the cards inside its own panel.
  document.querySelectorAll<HTMLButtonElement>('[data-show-more]').forEach((button) => {
    button.addEventListener('click', () => {
      const panel = button.closest<HTMLElement>('.project-tabs__panel');
      panel?.querySelectorAll<HTMLElement>('.projects-grid__item').forEach((item) => {
        item.hidden = false;
      });
      button.hidden = true;
    });
  });

  const root = document.querySelector<HTMLElement>('[data-project-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    // JS is on, so collapse to the first panel.
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.first !== 'true';
    });

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next !== null) {
          e.preventDefault();
          select(next);
        }
      });
    });
  }
</script>
