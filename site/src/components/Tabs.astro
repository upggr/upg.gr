---
/**
 * Accessible tabs (ARIA tablist + roving tabindex).
 * Falls back to all panels visible when JS is unavailable.
 */
interface Panel {
  id: string;
  label: string;
  items: readonly string[];
}
interface Props {
  panels: Panel[];
  idPrefix: string;
}
const { panels, idPrefix } = Astro.props as Props;
---

<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist">
    {panels.map((panel, i) => (
      <button
        type="button"
        role="tab"
        id={`${idPrefix}-tab-${panel.id}`}
        aria-controls={`${idPrefix}-panel-${panel.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="tabs__btn"
      >
        {panel.label}
      </button>
    ))}
  </div>

  {panels.map((panel, i) => (
    <div
      role="tabpanel"
      id={`${idPrefix}-panel-${panel.id}`}
      aria-labelledby={`${idPrefix}-tab-${panel.id}`}
      class="tabs__panel"
      data-first={i === 0 ? 'true' : 'false'}
      tabindex="0"
    >
      <ul class="tabs__items">
        {panel.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  ))}
</div>

<style>
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tabs__btn {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--surface));
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .tabs__btn:hover { color: hsl(var(--foreground)); border-color: hsl(var(--primary) / 0.5); }
  .tabs__btn[aria-selected='true'] {
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  .tabs__panel {
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-lg);
    background: hsl(var(--card));
    padding: clamp(1.1rem, 3vw, 1.75rem);
  }
  .tabs__panel + .tabs__panel { margin-top: 1rem; }
  /* With JS on, only the selected panel is shown */
  :global(html.js) .tabs__panel[hidden] { display: none; }
  :global(html.js) .tabs__panel + .tabs__panel { margin-top: 0; }

  .tabs__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .tabs__items li {
    position: relative;
    padding-inline-start: 1.1rem;
    font-size: 0.925rem;
    color: hsl(var(--foreground) / 0.9);
    min-width: 0;
  }
  .tabs__items li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.6em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: hsl(var(--primary));
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      if (focus) tabs[index].focus();
    };

    // JS is on: collapse to the first panel only.
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.first !== 'true';
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next !== null) {
          e.preventDefault();
          select(next);
        }
      });
    });
  });
</script>
