---
import { getDict, langFromUrl, type Lang } from '../i18n';

const lang = langFromUrl(Astro.url) as Lang;
const t = getDict(lang);
---

<section class="section section--tight" id="about">
  <div class="container about">
    <header class="reveal">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="section-title">{t.about.title}</h2>
    </header>
    <div class="about__body reveal">
      {t.about.body.map((paragraph) => <p class="card__text">{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: start;
  }
  @media (min-width: 60rem) {
    .about { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  }
  .about__body { display: grid; gap: 1rem; }
  .about__body p { font-size: 1rem; }
</style>
